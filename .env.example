# Optional: for "Apply to Your Life" LLM analysis
# Copy to .env and add your key (do not commit .env)

# OpenAI (or OpenAI-compatible) API key
VITE_OPENAI_API_KEY=sk-...

# Optional: override API URL for a different provider (e.g. Azure, local proxy)
# VITE_OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Optional: model name (default: gpt-4o-mini)
# VITE_OPENAI_MODEL=gpt-4o-mini

# Set to "false" if your API does not support response_format.json_object
# VITE_OPENAI_JSON_MODE=true
